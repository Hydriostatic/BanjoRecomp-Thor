+        const uint32_t currentGeneration = androidSurfaceGeneration.load(std::memory_order_acquire);
+        if ((surface == VK_NULL_HANDLE) || (surfaceGeneration != currentGeneration)) {
+            VulkanInterface *renderInterface = commandQueue->device->renderInterface;
