diff --git a/plume_vulkan.cpp b/plume_vulkan.cpp
index f1dd503..fdc8933 100644
--- a/plume_vulkan.cpp
+++ b/plume_vulkan.cpp
@@ -27,6 +27,26 @@
 // TODO:
 // - Fix resource pools.
 
+#if defined(__ANDROID__)
+#include <atomic>
+
+namespace {
+    // Android destroys the native window whenever the app leaves the screen and gives
+    // a new one when it comes back. The app tells us about it through this state so
+    // the swap chain can stop presenting and rebuild its surface afterwards.
+    std::atomic<bool> androidSurfaceReady{ true };
+    std::atomic<uint32_t> androidSurfaceGeneration{ 0 };
+}
+
+extern "C" __attribute__((visibility("default"))) void plume_android_set_surface_ready(int ready) {
+    if (ready) {
+        androidSurfaceGeneration.fetch_add(1, std::memory_order_acq_rel);
+    }
+
+    androidSurfaceReady.store(ready != 0, std::memory_order_release);
+}
+#endif
+
