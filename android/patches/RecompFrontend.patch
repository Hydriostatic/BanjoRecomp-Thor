 namespace recompui {
+#if defined(__ANDROID__)
+    // Android has no file dialogs, so the app's activity opens the system document picker
+    // and reports back through complete_android_document_picker().
+    namespace {
+        std::mutex android_picker_mutex;
+        std::function<void(bool, const std::list<std::filesystem::path>&)> android_picker_callback;
+
+        bool request_android_document_picker(bool multiple) {
+            JNIEnv* env = static_cast<JNIEnv*>(SDL_AndroidGetJNIEnv());
+            jobject activity = static_cast<jobject>(SDL_AndroidGetActivity());
+            if (env == nullptr || activity == nullptr) {
+                return false;
+            }
+
+            bool requested = false;
+            jclass activity_class = env->GetObjectClass(activity);
+            if (activity_class != nullptr) {
+                jmethodID method = env->GetMethodID(activity_class, "openDocumentPicker", "(Z)V");
+                if (method != nullptr) {
+                    env->CallVoidMethod(activity, method, multiple ? JNI_TRUE : JNI_FALSE);
+                    requested = !env->ExceptionCheck();
+                }
+
+                env->DeleteLocalRef(activity_class);
+            }
+
+            if (env->ExceptionCheck()) {
+                env->ExceptionClear();
+            }
+
+            env->DeleteLocalRef(activity);
+            return requested;
+        }
+
+        void open_android_document_picker(bool multiple, std::function<void(bool, const std::list<std::filesystem::path>&)> callback) {
+            {
+                std::lock_guard lock(android_picker_mutex);
+                android_picker_callback = std::move(callback);
+            }
+
+            if (!request_android_document_picker(multiple)) {
+                file::complete_android_document_picker(false, {});
+            }
+        }
+    }
+
+    void file::complete_android_document_picker(bool success, const std::list<std::filesystem::path>& paths) {
+        std::function<void(bool, const std::list<std::filesystem::path>&)> callback;
+        {
+            std::lock_guard lock(android_picker_mutex);
+            callback = std::move(android_picker_callback);
+            android_picker_callback = nullptr;
+        }
+
+        if (callback) {
+            callback(success && !paths.empty(), paths);
+        }
+    }
+#endif
+
     static void perform_file_dialog_operation(const std::function<void(bool, const std::filesystem::path&)>& callback) {
         nfdnchar_t* native_path = nullptr;
